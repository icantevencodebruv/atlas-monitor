#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$SCRIPT_DIR"
for _ in 1 2 3 4 5 6 7; do
  if [ -f "$ROOT/run.py" ]; then
    break
  fi
  ROOT="$(dirname "$ROOT")"
  if [ "$ROOT" = "/" ]; then
    break
  fi
done

if [ ! -f "$ROOT/run.py" ]; then
  osascript -e 'display dialog "Recorder root not found. Keep the app inside the project folder." buttons {"OK"} with icon stop'
  exit 1
fi

exec "$ROOT/tools/macos_installer/launch.sh"
